; S2 固定底座：固定立柱 v0 / EEF 精定位
; 参数基准：W2 fixed_base.info；保留本机立柱约束与 18 维关节布局。
; 头部软限速按本机 URDF 的 ±1.0 rad/s 设置。

model_information
{
    manipulatorModelType    0
    baseFrame               "base_footprint"
    eeFrame                 "left_eef"
    eeFrame1                "right_eef"

    bodyFrame               "body_link4"
    headFrame               "head_link2"

    removeJoints
    {
        [0]   "lift_joint"
        [1]   "left_gripper_joint"
        [2]   "right_gripper_joint"
        [3]   "left_right_finger_joint"
        [4]   "right_right_finger_joint"
        [5]   "left_left_in_Joint"
        [6]   "left_left_up_Joint"
        [7]   "left_left_2_Joint"
        [8]   "left_right_2_Joint"
        [9]   "left_right_1_Joint"
        [10]  "left_right_in_Joint"
        [11]  "left_right_up_Joint"
        [12]  "right_left_in_Joint"
        [13]  "right_left_up_Joint"
        [14]  "right_left_2_Joint"
        [15]  "right_right_2_Joint"
        [16]  "right_right_1_Joint"
        [17]  "right_right_in_Joint"
        [18]  "right_right_up_Joint"
    }
}

model_settings
{
    ; usePreComputation: true = 提前缓存 Pinocchio 中间量
    usePreComputation       true

    ; recompileLibraries: true = 每次启动重新生成 CppAD 动态库
    recompileLibraries      true
}

initialState
{
    arm
    {
        (0,0)   0.0     ; body_joint1  rotate [rad]
        (1,0)   0.0     ; body_joint2  pitch [rad]
        (2,0)   0.0     ; left_joint1
        (3,0)   0.0     ; left_joint2
        (4,0)   0.0     ; left_joint3
        (5,0)   0.0     ; left_joint4
        (6,0)   0.0     ; left_joint5
        (7,0)   0.0     ; left_joint6
        (8,0)   0.0     ; left_joint7
        (9,0)   0.0     ; right_joint1
        (10,0)  0.0     ; right_joint2
        (11,0)  0.0     ; right_joint3
        (12,0)  0.0     ; right_joint4
        (13,0)  0.0     ; right_joint5
        (14,0)  0.0     ; right_joint6
        (15,0)  0.0     ; right_joint7
        (16,0)  0.0     ; head_joint1
        (17,0)  0.0     ; head_joint2
    }
}

initialModeSchedule
{
    eventTimes
    {
    }

    modeSequence
    {
        [0]
        {
            bodyMode "HM_DUAL_RELATIVE_FIXED_BASE"
            headMode "HEAD_DISABLE"
        }
    }
}

ddp
{
    algorithm                       SLQ

    nThreads                        3
    threadPriority                  50

    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3

    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false

    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45

    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0

    preComputeRiccatiTerms          true

    useFeedbackPolicy               false

    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

mpc
{
    timeHorizon                     1.0     ; [s] 保留精定位配置的预测时域
    solutionTimeWindow              0.2     ; [s]
    coldStart                       false

    debugPrint                      false

    ; 独立 MPC/MRT 节点的期望频率；控制器实际频率由 ROS 参数
    ; mpc_frequency / update_rate 决定，不能仅依据本节判断实际运行频率。
    mpcDesiredFrequency             100     ; [Hz]
    mrtDesiredFrequency             500     ; [Hz]
}

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

bodyTrackingEE
{
    activate true
    muPosition 10.0
    muOrientation 5.0
}

; 头部 6D 跟踪末端（HEAD_TRACKING）：跟踪 model_information.headFrame
headTrackingEE
{
    activate true
    muPosition 5.0
    muOrientation 5.0
}

inputCost
{
    R
    {
        arm
        {
            ; R 为正对角矩阵；实际权重 = scaling * 对角值。
            ; 固定立柱无升降维；身体偏航/俯仰对应基准的 body_joint4/3。
            scaling 5e-2

            (0,0)      2.0     ; body_joint1
            (1,1)      3.0     ; body_joint2
            (2,2)      0.5     ; left_joint1
            (3,3)      0.5     ; left_joint2
            (4,4)      0.5     ; left_joint3
            (5,5)      0.5     ; left_joint4
            (6,6)      0.1     ; left_joint5
            (7,7)      0.1     ; left_joint6
            (8,8)      0.1     ; left_joint7
            (9,9)      0.5     ; right_joint1
            (10,10)    0.5     ; right_joint2
            (11,11)    0.5     ; right_joint3
            (12,12)    0.5     ; right_joint4
            (13,13)    0.1     ; right_joint5
            (14,14)    0.1     ; right_joint6
            (15,15)    0.1     ; right_joint7
            (16,16)    0.1     ; head_joint1
            (17,17)    0.1     ; head_joint2
        }
    }
}

endEffector
{
    muPosition                      100.0
    muOrientation                   50.0
}

finalEndEffector
{
    muPosition                      200.0
    muOrientation                   100.0
}

bodyRelative
{
    activate                        true
    bodyLinkName                    "body_link4"
    muPosition                      5.0
    muOrientation                   5.0
}

bimanualCoupling
{
    activate                        true
    muPosition                      100.0
    muOrientation                   12.5
}

headInputStart                          16

waistLock
{
    activate                        true
    numJoints                       2
}

headCoupling
{
    activate                        true
    waistJointIndex                 0
    headJointIndex                  16
    alpha                           1.0
    lockedWaistJoints
    {
        [0] 1
    }
}

customJointLock
{
    activate                        true
    lockedJointIndices
    {
    }

    waistPhiPositiveBias
    {
        activate                    true
        waistType                   "single_joint"
        pitchJointIndex             1       ; body_joint2 pitch
        pitchDirection              1.0
        pitchOffset                 0.0
        lowerBoundRad               0.0
        mu                          5.0
    }
}

; HOME 关节参考：打开后把未排除关节软拉向 controller HOME。
; mu 与关节限位同量级，避免压过末端追踪。
; 输入布局：[body_joint1~2 | left(7) | right(7) | head(2)]（无 lift）
; v0 无升降链，不排除腰关节，纳入 body_joint1（yaw）与 body_joint2（俯仰）。
homeJointReference
{
    activate                        true
    activateDefault                 false
    mu                              1e-3
    excludeJointIndices
    {
    }
}

armLock
{
    activate                        true
    leftNumJoints                   7
    rightNumJoints                  7
}

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-3

    lowerBound
    {
        arm
        {
            (0,0)      -0.5    ; body_joint1
            (1,0)      -0.5    ; body_joint2
            (2,0)      -1.57   ; left_joint1
            (3,0)      -1.57   ; left_joint2
            (4,0)      -1.57   ; left_joint3
            (5,0)      -1.57   ; left_joint4
            (6,0)      -1.57   ; left_joint5
            (7,0)      -1.57   ; left_joint6
            (8,0)      -1.57   ; left_joint7
            (9,0)      -1.57   ; right_joint1
            (10,0)     -1.57   ; right_joint2
            (11,0)     -1.57   ; right_joint3
            (12,0)     -1.57   ; right_joint4
            (13,0)     -1.57   ; right_joint5
            (14,0)     -1.57   ; right_joint6
            (15,0)     -1.57   ; right_joint7
            (16,0)     -1.0    ; head_joint1
            (17,0)     -1.0    ; head_joint2
        }
    }

    upperBound
    {
        arm
        {
            (0,0)      0.5     ; body_joint1
            (1,0)      0.5     ; body_joint2
            (2,0)      1.57    ; left_joint1
            (3,0)      1.57    ; left_joint2
            (4,0)      1.57    ; left_joint3
            (5,0)      1.57    ; left_joint4
            (6,0)      1.57    ; left_joint5
            (7,0)      1.57    ; left_joint6
            (8,0)      1.57    ; left_joint7
            (9,0)      1.57    ; right_joint1
            (10,0)     1.57    ; right_joint2
            (11,0)     1.57    ; right_joint3
            (12,0)     1.57    ; right_joint4
            (13,0)     1.57    ; right_joint5
            (14,0)     1.57    ; right_joint6
            (15,0)     1.57    ; right_joint7
            (16,0)     1.0     ; head_joint1
            (17,0)     1.0     ; head_joint2
        }
    }
}

selfCollision
{
    activate                        true
    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.01
    collisionObjectPairs
    {
    }
    collisionLinkPairs
    {
        [0] "body_link4, left_link3",
        [1] "body_link4, left_link4",
        [2] "body_link4, left_link5",
        [3] "body_link4, left_link7",
        [4] "body_link4, right_link3",
        [5] "body_link4, right_link4",
        [6] "body_link4, right_link5",
        [7] "body_link4, right_link7",
    }
}

;=============================================================================
; Head Midpoint Gaze Constraint
; 头部相机注视双手中点：仅由头部模式 HEAD_GAZE 独立控制，与身体模式（body mode，
; 含 CUSTOM_LOCKED）无关，也不要求 customJointLock.activate = true。
; fx/fy/cx/cy/width/height 为首版测试值，取自
; ros2_robot_interface/dynamics/box_fov_estimator.py 的 DEFAULT_HEAD_CAMERA_INTRINSICS。
;=============================================================================

headMidpointGaze
{
    activate                    true
    cameraFrame                 "head_camera"
    fx                          611.864502
    fy                          611.478271
    cx                          638.961182
    cy                          363.642456
    width                       1280
    height                      720
    horizontalDeadbandDeg       10.0    ; 水平免惩罚半角（度），仅惩罚超出部分
    verticalDeadbandDeg         10.0    ; 垂直免惩罚半角（度），仅惩罚超出部分
    muAlignmentHorizontal       1.0     ; 左右对齐权重
    muAlignmentVertical         0.0     ; 上下对齐权重，0 表示关闭
    muFront                     1.0
    minDepth                    0.3
}
