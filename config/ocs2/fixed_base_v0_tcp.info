; HOME 关节参考：打开后把未排除关节软拉向 controller HOME。
; mu 与关节限位同量级，避免压过末端追踪。
; 输入布局：[body_joint1~2 | left(7) | right(7) | head(2)]（无 lift）
; 高动态 tcp 变体默认开启（activateDefault true）。
homeJointReference
{
    activate                        true
    activateDefault                 true
    mu                              1e-3
    excludeJointIndices
    {
    }
}

headCoupling
{
    activate                        true
    waistJointIndex                 0
    headJointIndex                  16
    alpha                           1.0
    lockedWaistJoints
    {
        [0] 1
    }
}

armLock
{
    activate                        true
    leftNumJoints                   7
    rightNumJoints                  7
}

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

